<?php

declare(strict_types=1);

namespace App\Policies;

use App\Models\Comment;
use App\Models\User;

/**
 * Standalone Comment policy (no Filament Shield / Spatie permissions required).
 *
 * Publish from joranski/filament-comments:
 *   php artisan vendor:publish --tag=filament-comments-policy
 *
 * Adjust rules to match your staff roles. Super-user checks can be added here.
 */
class CommentPolicy
{
    public function viewAny(User $user): bool
    {
        return true;
    }

    public function view(User $user, Comment $comment): bool
    {
        return true;
    }

    public function create(User $user): bool
    {
        return true;
    }

    public function update(User $user, Comment $comment): bool
    {
        return $comment->user_id === $user->id;
    }

    public function delete(User $user, Comment $comment): bool
    {
        return $comment->user_id === $user->id;
    }

    public function deleteAny(User $user): bool
    {
        return false;
    }

    public function restore(User $user, Comment $comment): bool
    {
        return false;
    }

    public function forceDelete(User $user, Comment $comment): bool
    {
        return false;
    }

    public function forceDeleteAny(User $user): bool
    {
        return false;
    }

    public function restoreAny(User $user): bool
    {
        return false;
    }

    public function replicate(User $user, Comment $comment): bool
    {
        return false;
    }

    public function reorder(User $user): bool
    {
        return false;
    }
}
